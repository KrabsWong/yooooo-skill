{
  "name": "yooooo-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable Agent Skills managed with safe symlink workflows.",
  "license": "AGPL-3.0-only",
  "bin": {
    "yooooo-skills": "./scripts/manage-skills.mjs",
    "yooooo-skills-install": "./scripts/manage-skills.mjs"
  },
  "scripts": {
    "build:bin": "bun build --compile --target=bun --outfile=bin/yooooo-skills scripts/manage-skills.mjs",
    "manage-skills": "node scripts/manage-skills.mjs",
    "install-skills": "node scripts/manage-skills.mjs",
    "uninstall-skills": "node scripts/manage-skills.mjs --uninstall",
    "list-skills": "node scripts/manage-skills.mjs --list",
    "installed-skills": "node scripts/manage-skills.mjs --installed",
    "test": "node --test scripts/manage-skills.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "react-devtools-core": "^4.28.5"
  }
}
